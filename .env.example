# Copy this file to .env and fill in the values. .env is never committed.
# LLM providers (config/models.yaml says which role uses which one)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
# Database (docker compose up -d starts it on port 5433)
DATABASE_URL=postgresql://scout:scout@localhost:5433/product_scout
TEST_DATABASE_URL=postgresql://scout:scout@localhost:5433/product_scout_test
EVAL_DATABASE_URL=postgresql://scout:scout@localhost:5433/product_scout_eval
# Web search. SearXNG runs in Docker; Tavily is the other back end (optional)
SEARXNG_URL=http://localhost:8888
TAVILY_API_KEY=
# Optional. Reddit API (app-only grant) for forum threads
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional. Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional. Cloudflare tunnel (docker compose --profile tunnel)
TUNNEL_TOKEN=
